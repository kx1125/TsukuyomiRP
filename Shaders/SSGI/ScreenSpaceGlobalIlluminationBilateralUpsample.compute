#pragma only_renderers d3d11 vulkan metal
#pragma kernel BilateralUpsample

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/tsukuyomi.render-pipelines.universal/ShaderLibrary/DenoiseUtils.hlsl"

#define SSGI_TILE_SIZE 8

Texture2D<float4> _InputIndirectDiffuseTexture;
Texture2D<float> _CameraDepthTexture;
RWTexture2D<float4> _OutputIndirectDiffuseTextureRW;

float4 _FullResolution;
float4 _InputResolution;

[numthreads(SSGI_TILE_SIZE, SSGI_TILE_SIZE, 1)]
void BilateralUpsample(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 coord = dispatchThreadId.xy;
    if (any(coord >= (uint2)_FullResolution.xy))
        return;

    float2 uv = (coord + 0.5) * _FullResolution.zw;
    float centerDepth = LinearEyeDepth(_CameraDepthTexture.Load(int3(coord, 0)), _ZBufferParams);
    float2 lowPosition = uv * _InputResolution.xy - 0.5;
    int2 lowBase = (int2)floor(lowPosition);
    int2 lowLimit = (int2)_InputResolution.xy - 1;
    float3 colorSum = 0.0;
    float weightSum = 0.0;

    [unroll]
    for (int y = 0; y <= 1; y++)
    {
        [unroll]
        for (int x = 0; x <= 1; x++)
        {
            int2 lowCoord = clamp(lowBase + int2(x, y), 0, lowLimit);
            float2 sampleUv = (lowCoord + 0.5) * _InputResolution.zw;
            uint2 sampleFullCoord = min((uint2)(sampleUv * _FullResolution.xy), (uint2)_FullResolution.xy - 1);
            float sampleDepth = LinearEyeDepth(_CameraDepthTexture.Load(int3(sampleFullCoord, 0)), _ZBufferParams);
            float bilinearWeight = DenoiseBilinearWeight((float2)lowCoord - lowPosition);
            float depthWeight = DenoiseExponentialDepthWeight(centerDepth, sampleDepth, max(0.02, centerDepth * 0.015));
            float weight = max(0.0001, bilinearWeight * depthWeight);
            colorSum += _InputIndirectDiffuseTexture.Load(int3(lowCoord, 0)).rgb * weight;
            weightSum += weight;
        }
    }

    _OutputIndirectDiffuseTextureRW[coord] = float4(colorSum / max(weightSum, 0.0001), 1.0);
}
